<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_page">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top Header / App Bar (Literary Sanctuary Header) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@color/surface_card"
            android:elevation="1dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <TextView
                android:id="@+id/tvHeaderTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="serif"
                android:letterSpacing="-0.01"
                android:text="@string/app_name"
                android:textColor="@color/primary_navy"
                android:textSize="23sp"
                android:textStyle="bold" />

            <!-- Language Switch Capsule (Flag + Code) -->
            <LinearLayout
                android:id="@+id/btnLanguage"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:background="@drawable/bg_lang_badge"
                android:clickable="true"
                android:contentDescription="@string/btn_language"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="10dp">

                <ImageView
                    android:id="@+id/ivLangFlag"
                    android:layout_width="20dp"
                    android:layout_height="14dp"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_flag_vn" />

                <TextView
                    android:id="@+id/tvLangCode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:text="VI"
                    android:textColor="@color/primary_navy"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Reading Reminder Notification Bell Button with Indicator Dot -->
            <FrameLayout
                android:id="@+id/btnReminder"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_btn_icon_action"
                android:clickable="true"
                android:contentDescription="@string/btn_reading_reminder"
                android:focusable="true">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_notifications"
                    app:tint="@color/text_primary" />

                <!-- Active Dot -->
                <View
                    android:id="@+id/viewReminderDot"
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="8dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_status_badge"
                    android:backgroundTint="@color/secondary_oak"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>
        <!-- Main Fragment Container for Swapping Library, Collections, Statistics, Settings -->
        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/mainFragmentContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>

    <!-- Floating Action Button for Adding Book (Midnight Navy Circle) -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAddBook"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="76dp"
        android:contentDescription="@string/fab_add_book"
        android:src="@drawable/ic_add"
        app:backgroundTint="@color/primary_navy"
        app:elevation="6dp"
        app:fabCustomSize="54dp"
        app:maxImageSize="26dp"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
        app:tint="#FFFFFF" />

    <!-- Bottom Navigation Bar (Literary Sanctuary Style) -->
    <LinearLayout
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_gravity="bottom"
        android:background="@color/surface_card"
        android:elevation="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="4dp">

        <!-- Item 1: BookNest (Active) -->
        <LinearLayout
            android:id="@+id/navLibrary"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/iconNavLibrary"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_book_open"
                app:tint="@color/secondary_oak" />

            <TextView
                android:id="@+id/textNavLibrary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/nav_library"
                android:textColor="@color/secondary_oak"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Item 2: Bộ sưu tập -->
        <LinearLayout
            android:id="@+id/navCollections"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/iconNavCollections"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_collections_bookmark"
                app:tint="@color/text_secondary" />

            <TextView
                android:id="@+id/textNavCollections"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/nav_collections"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Item 3: Thống kê -->
        <LinearLayout
            android:id="@+id/navStatistics"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/iconNavStatistics"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_bar_chart"
                app:tint="@color/text_secondary" />

            <TextView
                android:id="@+id/textNavStatistics"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/nav_statistics"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Item 4: Cài đặt -->
        <LinearLayout
            android:id="@+id/navSettings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/iconNavSettings"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_settings"
                app:tint="@color/text_secondary" />

            <TextView
                android:id="@+id/textNavSettings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/nav_settings"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>