<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_card"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/tvIconDialogTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Thư viện biểu tượng"
        android:textColor="@color/text_primary"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Chọn biểu tượng đại diện phù hợp với bộ sưu tập của bạn"
        android:textColor="@color/text_secondary"
        android:textSize="12.5sp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvIconPicker"
        android:layout_width="match_parent"
        android:layout_height="280dp"
        android:layout_marginTop="14dp"
        android:overScrollMode="never"
        android:scrollbars="vertical" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnCancelIcon"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_btn_cancel"
        android:stateListAnimator="@null"
        android:text="@android:string/cancel"
        android:textAllCaps="false"
        android:textColor="@color/btn_cancel_text"
        android:textSize="13.5sp"
        android:textStyle="bold" />
</LinearLayout>

