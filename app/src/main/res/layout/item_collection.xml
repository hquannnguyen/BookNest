<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardCollection"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="6dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/surface_card"
    app:cardCornerRadius="16dp"
    app:cardElevation="1dp"
    app:strokeColor="@color/outline_variant"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Header: Icon, Title, Subtitle, More Button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/containerIcon"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_lang_badge">

                <ImageView
                    android:id="@+id/ivCollectionIcon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_auto_stories"
                    app:tint="@color/secondary_oak" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvCollectionName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="serif"
                    android:maxLines="1"
                    android:text="Tên Bộ Sưu Tập"
                    android:textColor="@color/primary_navy"
                    android:textSize="17.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvCollectionSub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/text_secondary"
                    android:textSize="11.5sp"
                    tools:text="0 cuốn sách • Vừa cập nhật" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnMore"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/collection_menu_edit"
                android:src="@drawable/ic_more_vert"
                app:tint="@color/text_secondary" />
        </LinearLayout>

        <!-- Shelf: Overlapping Covers + Progress Counters -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Overlapping Covers Stack -->
            <FrameLayout
                android:id="@+id/layoutCoversStack"
                android:layout_width="0dp"
                android:layout_height="76dp"
                android:layout_weight="1">

                <!-- Cover 1 (Leftmost, Bottom of stack) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardCover1"
                    android:layout_width="48dp"
                    android:layout_height="72dp"
                    android:layout_gravity="start|center_vertical"
                    android:layout_marginStart="0dp"
                    app:cardCornerRadius="6dp"
                    app:cardElevation="2dp"
                    app:strokeColor="@color/outline_variant"
                    app:strokeWidth="0.5dp">

                    <ImageView
                        android:id="@+id/ivCover1"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@color/surface_container"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_auto_stories"
                        app:tint="@color/text_hint" />
                </com.google.android.material.card.MaterialCardView>

                <!-- Cover 2 (Middle) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardCover2"
                    android:layout_width="48dp"
                    android:layout_height="72dp"
                    android:layout_gravity="start|center_vertical"
                    android:layout_marginStart="32dp"
                    app:cardCornerRadius="6dp"
                    app:cardElevation="4dp"
                    app:strokeColor="@color/outline_variant"
                    app:strokeWidth="0.5dp">

                    <ImageView
                        android:id="@+id/ivCover2"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@color/surface_container"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_auto_stories"
                        app:tint="@color/text_hint" />
                </com.google.android.material.card.MaterialCardView>

                <!-- Cover 3 (Rightmost of book covers) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardCover3"
                    android:layout_width="48dp"
                    android:layout_height="72dp"
                    android:layout_gravity="start|center_vertical"
                    android:layout_marginStart="64dp"
                    app:cardCornerRadius="6dp"
                    app:cardElevation="6dp"
                    app:strokeColor="@color/outline_variant"
                    app:strokeWidth="0.5dp">

                    <ImageView
                        android:id="@+id/ivCover3"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@color/surface_container"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_auto_stories"
                        app:tint="@color/text_hint" />
                </com.google.android.material.card.MaterialCardView>

                <!-- More (+N) indicator badge -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardCoverMore"
                    android:layout_width="48dp"
                    android:layout_height="72dp"
                    android:layout_gravity="start|center_vertical"
                    android:layout_marginStart="96dp"
                    app:cardBackgroundColor="@color/surface_container_low"
                    app:cardCornerRadius="6dp"
                    app:cardElevation="1dp"
                    app:strokeColor="@color/outline_variant"
                    app:strokeWidth="0.5dp">

                    <TextView
                        android:id="@+id/tvCoverMore"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="+2"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </com.google.android.material.card.MaterialCardView>

            </FrameLayout>

            <!-- Progress Column (Right) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.05"
                    android:text="@string/collection_item_label_progress"
                    android:textColor="@color/secondary_oak"
                    android:textSize="9.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvProgressFraction"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="serif"
                    android:text="0 / 0"
                    android:textColor="@color/primary_navy"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvProgressStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="@string/collection_item_books_read"
                    android:textColor="@color/text_hint"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Mini Progress Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/collection_item_reading_progress"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvProgressPercent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0%"
                    android:textColor="@color/secondary_oak"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/progressBarCollection"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="4dp"
                android:max="100"
                android:progress="0"
                android:progressDrawable="@drawable/progress_reading_detail" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
