<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_page"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- 1. Top Header (BookNest + Language + Bell Notification) -->
    <LinearLayout
        android:id="@+id/layoutTopHeader"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/bg_page"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="serif"
            android:letterSpacing="-0.02"
            android:text="@string/app_name"
            android:textColor="@color/primary_navy"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- Language Switch Capsule (Flag + Code) -->
        <LinearLayout
            android:id="@+id/btnLanguage"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:background="@drawable/bg_lang_badge"
            android:clickable="true"
            android:contentDescription="@string/btn_language"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp">

            <ImageView
                android:id="@+id/ivFlag"
                android:layout_width="18dp"
                android:layout_height="13dp"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_flag_vn" />

            <TextView
                android:id="@+id/tvLangCode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:text="VI"
                android:textColor="@color/text_primary"
                android:textSize="12.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Reminder Icon Button (Bell) -->
        <FrameLayout
            android:id="@+id/btnReminder"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@string/btn_reading_reminder"
            android:focusable="true">

            <ImageView
                android:layout_width="23dp"
                android:layout_height="23dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_notifications"
                app:tint="@color/text_primary" />

            <View
                android:id="@+id/dotReminder"
                android:layout_width="7.5dp"
                android:layout_height="7.5dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_status_badge" />
        </FrameLayout>
    </LinearLayout>

    <!-- 2. Sub-Header / Back Bar & Context Actions -->
    <LinearLayout
        android:id="@+id/layoutSubHeader"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:background="@color/bg_page"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <LinearLayout
            android:id="@+id/btnBack"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="4dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/secondary_oak" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:letterSpacing="0.05"
                android:text="BỘ SƯU TẬP"
                android:textColor="@color/secondary_oak"
                android:textSize="12.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnShare"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Chia sẻ"
            android:src="@drawable/ic_share"
            app:tint="@color/text_secondary" />

        <ImageButton
            android:id="@+id/btnMoreOptions"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="2dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Tùy chọn"
            android:src="@drawable/ic_more_vert"
            app:tint="@color/text_secondary" />
    </LinearLayout>

    <!-- 3. Main Scrollable Content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBookshelf3d"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:layout_marginHorizontal="16dp"
                android:text="@string/bookshelf_open"
                android:textColor="@color/surface_card"
                app:backgroundTint="@color/primary_navy"
                app:cornerRadius="12dp" />
            <!-- Hero Card / Collection Overview -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardHero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/surface_container_lowest"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/border_color"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Icon & Title row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="top"
                        android:orientation="horizontal">

                        <!-- Icon Container Box -->
                        <FrameLayout
                            android:id="@+id/layoutIconContainer"
                            android:layout_width="54dp"
                            android:layout_height="54dp"
                            android:background="@drawable/bg_hero_icon_container">

                            <ImageView
                                android:id="@+id/ivCollectionIcon"
                                android:layout_width="30dp"
                                android:layout_height="30dp"
                                android:layout_gravity="center"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_psychology"
                                app:tint="@color/on_secondary_container" />
                        </FrameLayout>

                        <!-- Title & Badge -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <!-- Category Badge -->
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_pill_inactive"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="3dp">

                                <View
                                    android:layout_width="5dp"
                                    android:layout_height="5dp"
                                    android:background="@drawable/bg_status_badge" />

                                <TextView
                                    android:id="@+id/tvCategoryBadge"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="5dp"
                                    android:letterSpacing="0.04"
                                    android:text="CHUYÊN ĐỀ CỐT LÕI"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="10.5sp"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/tvCollectionTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:fontFamily="serif"
                                android:letterSpacing="-0.01"
                                android:lineSpacingExtra="2dp"
                                android:textColor="@color/primary_navy"
                                android:textSize="20sp"
                                android:textStyle="bold"
                                tools:text="Triết Học &amp; Nhân Sinh" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Description -->
                    <TextView
                        android:id="@+id/tvCollectionDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:lineSpacingExtra="3dp"
                        android:textColor="@color/text_secondary"
                        android:textSize="13.5sp"
                        tools:text="Tuyển tập những cuốn sách triết học ứng dụng, chiêm nghiệm ý nghĩa cuộc sống và rèn luyện tâm trí qua lăng kính của các hiền triết phương Đông lẫn phương Tây." />

                    <!-- Key Metrics (3 columns) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/bg_hero_metrics"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <!-- Metric 1: Tổng số -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:letterSpacing="0.04"
                                android:text="TỔNG SỐ"
                                android:textColor="@color/text_hint"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvTotalBooksMetric"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="serif"
                                android:textColor="@color/primary_navy"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                tools:text="6 cuốn" />
                        </LinearLayout>

                        <!-- Metric 2: Đã xong -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:letterSpacing="0.04"
                                android:text="ĐÃ XONG"
                                android:textColor="@color/text_hint"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvCompletedBooksMetric"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="serif"
                                android:textColor="@color/secondary_oak"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                tools:text="4 / 6" />
                        </LinearLayout>

                        <!-- Metric 3: Khối lượng -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:letterSpacing="0.04"
                                android:text="KHỐI LƯỢNG"
                                android:textColor="@color/text_hint"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvTotalPagesMetric"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="serif"
                                android:textColor="@color/primary_navy"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                tools:text="1.850 tr" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Reading Progress Bar -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:letterSpacing="0.04"
                            android:text="TIẾN ĐỘ HOÀN THÀNH BỘ SƯU TẬP"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvProgressPercentage"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/secondary_oak"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            tools:text="67%" />
                    </LinearLayout>

                    <ProgressBar
                        android:id="@+id/pbCollectionProgress"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="7dp"
                        android:layout_marginTop="6dp"
                        android:progressDrawable="@drawable/progress_reading_detail"
                        tools:progress="67" />

                    <!-- Footer Details (Update time + Offline) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="13dp"
                                android:layout_height="13dp"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_schedule"
                                app:tint="@color/text_hint" />

                            <TextView
                                android:id="@+id/tvLastUpdated"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:textColor="@color/text_hint"
                                android:textSize="11.5sp"
                                tools:text="Cập nhật gần đây" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="13dp"
                                android:layout_height="13dp"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_cloud_done"
                                app:tint="@color/text_hint" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:text="SQLite Ngoại tuyến"
                                android:textColor="@color/text_hint"
                                android:textSize="11.5sp" />
                        </LinearLayout>
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Featured Quote Card ("Tâm đắc nhất trong bộ") -->
            <FrameLayout
                android:id="@+id/cardFeaturedQuote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_btn_primary_rounded"
                android:clipToPadding="true"
                android:elevation="3dp">

                <!-- Watermark Quote Icon in corner -->
                <ImageView
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:layout_gravity="bottom|end"
                    android:layout_marginBottom="-24dp"
                    android:layout_marginEnd="-20dp"
                    android:alpha="0.08"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_format_quote"
                    app:tint="#FFFFFF" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <!-- Header Row -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_auto_awesome"
                            app:tint="@color/secondary_fixed" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:letterSpacing="0.05"
                            android:text="TÂM ĐẮC NHẤT TRONG BỘ"
                            android:textColor="@color/secondary_fixed"
                            android:textSize="11.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Quote Text -->
                    <TextView
                        android:id="@+id/tvFeaturedQuoteContent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:fontFamily="serif"
                        android:lineSpacingExtra="4dp"
                        android:textColor="#FBF9F8"
                        android:textSize="15.5sp"
                        android:textStyle="italic"
                        tools:text="“Người có một lý do để sống có thể chịu đựng được hầu như mọi nghịch cảnh.”" />

                    <!-- Source & Page -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvFeaturedQuoteSource"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="#D7E2FF"
                            android:textSize="12.5sp"
                            tools:text="Đi Tìm Lẽ Sống — Viktor Frankl" />

                        <TextView
                            android:id="@+id/tvFeaturedQuotePage"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/secondary_fixed"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            tools:text="Trang 104" />
                    </LinearLayout>

                </LinearLayout>
            </FrameLayout>

            <!-- Action Bar & Controls -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Add Book Button -->
                <LinearLayout
                    android:id="@+id/btnAddBooks"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_btn_primary_rounded"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_add"
                        app:tint="#FFFFFF" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="Thêm sách vào bộ"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Sort Button -->
                <LinearLayout
                    android:id="@+id/btnSort"
                    android:layout_width="wrap_content"
                    android:layout_height="46dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_btn_sort_rounded"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_sort"
                        app:tint="@color/text_secondary" />

                    <TextView
                        android:id="@+id/tvSortLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="Tiến độ"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Filter Pills (Horizontally Scrollable) -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:clipToPadding="false"
                android:paddingHorizontal="16dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Pill: Tất cả -->
                    <TextView
                        android:id="@+id/pillFilterAll"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_pill_active"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="7dp"
                        android:textColor="#FFFFFF"
                        android:textSize="12.5sp"
                        android:textStyle="bold"
                        tools:text="Tất cả (6)" />

                    <!-- Pill: Đang đọc -->
                    <TextView
                        android:id="@+id/pillFilterReading"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_pill_inactive"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="7dp"
                        android:textColor="@color/text_secondary"
                        android:textSize="12.5sp"
                        tools:text="Đang đọc (1)" />

                    <!-- Pill: Đã xong -->
                    <TextView
                        android:id="@+id/pillFilterCompleted"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_pill_inactive"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="7dp"
                        android:textColor="@color/text_secondary"
                        android:textSize="12.5sp"
                        tools:text="Đã xong (4)" />

                    <!-- Pill: Chưa đọc -->
                    <TextView
                        android:id="@+id/pillFilterUnread"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_pill_inactive"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="7dp"
                        android:textColor="@color/text_secondary"
                        android:textSize="12.5sp"
                        tools:text="Chưa đọc (1)" />
                </LinearLayout>
            </HorizontalScrollView>

            <!-- Books RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerCollectionBooks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                tools:itemCount="3"
                tools:listitem="@layout/item_collection_detail_book" />

            <!-- Empty State View -->
            <LinearLayout
                android:id="@+id/layoutEmptyState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingVertical="32dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:alpha="0.4"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_auto_stories"
                    app:tint="@color/secondary_oak" />

                <TextView
                    android:id="@+id/tvEmptyTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:fontFamily="serif"
                    android:text="Chưa có sách trong bộ sưu tập này"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvEmptySubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:text="Nhấn nút bên dưới để chọn các tác phẩm phù hợp"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnEmptyAddBooks"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:layout_marginTop="16dp"
                    android:backgroundTint="@color/primary_navy"
                    android:text="+ Thêm sách vào bộ"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- 4. Persistent Bottom Navigation Bar -->
    <LinearLayout
        android:id="@+id/layoutBottomNav"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/bg_page"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="4dp">

        <!-- 1. Tủ sách -->
        <LinearLayout
            android:id="@+id/navLibrary"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/iconNavLibrary"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_book_open"
                app:tint="@color/text_secondary" />

            <TextView
                android:id="@+id/textNavLibrary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/nav_library"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- 2. Bộ sưu tập (ACTIVE) -->
        <LinearLayout
            android:id="@+id/navCollections"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/iconNavCollections"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_collections_bookmark"
                app:tint="@color/secondary_oak" />

            <TextView
                android:id="@+id/textNavCollections"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/nav_collections"
                android:textColor="@color/secondary_oak"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 3. Thống kê -->
        <LinearLayout
            android:id="@+id/navStatistics"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/iconNavStatistics"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_bar_chart"
                app:tint="@color/text_secondary" />

            <TextView
                android:id="@+id/textNavStatistics"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/nav_statistics"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- 4. Cài đặt -->
        <LinearLayout
            android:id="@+id/navSettings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/iconNavSettings"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_settings"
                app:tint="@color/text_secondary" />

            <TextView
                android:id="@+id/textNavSettings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/nav_settings"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
