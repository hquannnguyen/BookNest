<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layoutIconItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="6dp">

    <FrameLayout
        android:id="@+id/containerIconBg"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:background="@drawable/bg_chip_unselected">

        <ImageView
            android:id="@+id/ivItemIcon"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_auto_stories"
            app:tint="@color/primary_navy" />

        <ImageView
            android:id="@+id/ivSelectedCheck"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_gravity="top|end"
            android:layout_margin="3dp"
            android:src="@drawable/ic_check_circle"
            android:visibility="gone"
            app:tint="@color/secondary_oak" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvItemIconLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:fontFamily="serif"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="@color/text_primary"
        android:textSize="11.5sp"
        tools:text="Sách mở" />

</LinearLayout>
